# César Barón — Environment Variables
# Copy this file to .env and fill in the real values before running the server.
# Never commit .env to version control.

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Connection string from MongoDB Atlas or self-hosted instance.
MONGODB_URI=

# Database name (default: cesar_portfolio)
MONGODB_DATABASE=cesar_portfolio

# ─── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather.
NUXT_TELEGRAM_BOT_TOKEN=

# Chat ID (or channel ID) where notifications will be sent.
NUXT_TELEGRAM_CHAT_ID=

# ─── Cloudflare Turnstile ────────────────────────────────────────────────────
# Site key (public — shown in the widget).
# Use "1x00000000000000000000AA" for always-pass testing.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key (server-side verification).
# Use "1x0000000000000000000000000000000AA" for always-pass testing.
NUXT_TURNSTILE_SECRET_KEY=

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Random secret used to hash IP addresses before storing them.
# Generate with: openssl rand -hex 32
NUXT_RATE_LIMIT_SALT=

# ─── Site ────────────────────────────────────────────────────────────────────
# Full URL of the site (no trailing slash). Used for CORS/Origin validation.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
